<UserControl 
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" 
	x:Class="Battleship.Users.Avalonia.Views.GameView"
	x:CompileBindings="True"
	xmlns:vm="using:Battleship.Users.Avalonia.ViewModels"
	x:DataType="vm:GameViewModel"
	KeyDown="KeyEvent">
	<Design.DataContext>
		<vm:GameViewModel />
	</Design.DataContext>
	<StackPanel VerticalAlignment="Center" Spacing="5" >
		
		<Button 
			Name="ButtonStartGame" 
			HorizontalContentAlignment="Center" 
			VerticalContentAlignment="Center" 
			VerticalAlignment="Center" 
			HorizontalAlignment="Center" 
			Height="60" Width="200" 
			FontSize="16" 
			FontWeight="SemiBold"
			Command="{Binding Go}"
			IsVisible="{Binding VisibleStartGame}">
			Start to Play!
		</Button>
		<Canvas Name="Snake" IsVisible="{Binding VisibleCavas}">
			<Rectangle Width="30" Height="30" Name="SnakeBody" PointerEntered="PointerEvent">
				<Rectangle.Fill>Red</Rectangle.Fill>
			</Rectangle>
			<Canvas.Children>
				<Button Height="50" Width="50" KeyDown="KeyEvent"></Button>
			</Canvas.Children>
			<Canvas.KeyBindings>
				<KeyBinding Gesture="Q"></KeyBinding>
			</Canvas.KeyBindings>
		</Canvas>
	</StackPanel>


</UserControl>
