<UserControl 
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" 
	x:Class="AvalonLogin.Views.RegitrationView"
	xmlns:vm="using:AvalonLogin.ViewModels"
	x:DataType="vm:RegitrationViewModel"
	MinHeight="350"
	MinWidth="300"
	Height="350"
	Width="300"
			 >
	<Design.DataContext>
		<vm:RegitrationViewModel />
	</Design.DataContext>
	<StackPanel VerticalAlignment="Center" Spacing="5">
	</StackPanel>	
	
</UserControl>
