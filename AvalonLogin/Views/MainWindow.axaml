<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvalonLogin.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AvalonLogin.Views"
        x:Class="AvalonLogin.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Login menu"
		MinHeight="350"
		MinWidth="300"
		Height="350"
		Width="300">
        <views:MainView DataContext="{Binding Context}"/>
	<Window.Styles>
		<StyleInclude Source="/Views/MainWindowStyles.axaml"/>
	</Window.Styles>

	
</Window>
